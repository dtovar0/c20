# DATABASE CONFIGURATION
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexus_db
DB_USER=admin
DB_PASS=
DB_SSL=false

# SYSTEM FOLDERS
ASSETS_DIR=assets
templates_DIR=templates

# PSX CONFIGURATION
PSX_IP=10.133.39.5
PSX_USER=admin
PSX_PASS=
PSX_PORT=8122

# WORKER CONFIGURATION
PSX_STALE_TASK_TIMEOUT=60
PSX_WATCHDOG_ENABLED=true

# SSO / AUTHELIA CONFIGURATION
AUTHELIA_ENABLED=false
AUTHELIA_SSO_URL=https://auth.example.com
AUTHELIA_SLO_URL=https://auth.example.com/logout
AUTHELIA_HEADER_USER=Remote-Email
AUTHELIA_HEADER_NAME=Remote-Name
AUTHELIA_HEADER_GROUPS=Remote-Groups
AUTHELIA_GROUP_ADMIN=InfraestructuraVOIP
DEBUG_AUTH=true




# C20 CONFIGURATION
C20_HOST=10.131.1.133
C20_PORT=23
C20_USER=
C20_PASS=
# Zona operativa por defecto del lote.
# OJO: el valor 900 no es un parámetro más — conmuta el alta en OFC2CODE a la
# rama 'TRMT OFC UNDN' (terminación) en vez de 'RTE DEST'. Afecta a TODAS las tareas.
C20_ZONA_DEFAULT=504
C20_CHUNK_SIZE=200
# Destino de ruteo para zonas != 900 (el sistema legado lo tenía fijo en 504)
C20_DEST_DEFAULT=504
# Segundos de espera entre tablas dentro de la sesión
C20_SLEEP_BETWEEN_TABLES=5
# Espera tras cada consulta al nodo, y tope de respuesta
C20_CMD_DELAY=1
C20_EXPECT_TIMEOUT=15

# --- LOG DEL MOTOR C20 ---
# Dos registros independientes, además del que ya se guarda en BD por tarea
# (tabla c20_command_logs, visible en el detalle de la tarea en la web):
#
#   C20_LOG_ENABLED -> escribe logs/c20_worker.log de forma continua, con
#                      rotación. Sobrevive a una sesión interrumpida, a
#                      diferencia del log en BD, que solo se guarda al cerrar
#                      la tarea.
#   DEBUG_C20       -> además hace eco del flujo a stdout. Bajo systemd eso va
#                      al journal (journalctl -u nexus-c20-worker -f); si el
#                      proceso se lanzó redirigido a /dev/null, se pierde.
#
# OJO: el flujo incluye la sesión completa con el nodo. Revisar quién lee
# logs/ antes de dejar esto encendido de forma permanente.
C20_LOG_ENABLED=true
DEBUG_C20=false
# Rotación: 10 MB por archivo, 5 archivos de respaldo
C20_LOG_MAX_BYTES=10485760
C20_LOG_BACKUPS=5

# C20 WORKER
# Worker: un solo proceso atiende C20 y Teams (el nodo admite una conexión)
C20_WATCHDOG_ENABLED=true
C20_WATCHDOG_LOOP_INTERVAL=60
C20_NOTIFY_TASK_TIMEOUT=60
C20_KILL_TASK_TIMEOUT=90
C20_NOTIFY_AGAIN_INTERVAL=30

# TEAMS CONFIGURATION
# El prefijo entra literalmente en el comando del nodo:
#   prefijo == 100 -> 'RTE DEST 16' (ruteo directo)
#   resto          -> 'DMOD INSRT <prefijo> XLT PX2 MSTEAMS2'
TEAMS_PREFIJO_DIRECTO=100
TEAMS_DEST_DIRECTO=16
TEAMS_XLT=PX2
TEAMS_TRONCAL=MSTEAMS2
TEAMS_PREFIJO_DEFAULT=
TEAMS_CHUNK_SIZE=200

